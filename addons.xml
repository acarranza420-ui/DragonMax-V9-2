<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <addon id="repository.dragonmax" name="DragonMax Repository" version="4.0.0" provider-name="DragonMax RD">
    <extension point="xbmc.addon.repository" name="DragonMax Repository">
      <dir minversion="21.0.0">
        <info compressed="false">https://acarranza420-ui.github.io/DragonMax-V9-2/addons.xml</info>
        <checksum>https://acarranza420-ui.github.io/DragonMax-V9-2/addons.xml.md5</checksum>
        <datadir zip="true">https://acarranza420-ui.github.io/DragonMax-V9-2/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>DragonMax V12 Unified repository</summary>
      <description>DragonMax V12 Unified repository for Kodi 21+ with manifest-driven installation, validation, backup, recovery, realms, and Fire TV Stick 4K Max tuning.</description>
      <platform>all</platform>
    </extension>
  </addon>

  <addon id="plugin.program.dragonmaxwizard" name="DragonMax Wizard" version="4.0.0" provider-name="DragonMax RD">
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>DragonMax V12 Unified transactional installer</summary>
      <description>Downloads, validates, backs up, stages, repairs, and applies DragonMax V12 Unified build payloads with safer failure handling.</description>
      <platform>all</platform>
    </extension>
  </addon>
</addons>
