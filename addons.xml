<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <addon id="repository.dragonmax" name="DragonMax Repository" version="1.9.3" provider-name="DragonMax RD">
    <extension point="xbmc.addon.repository" name="DragonMax Repository">
      <dir minversion="21.0.0">
        <info compressed="false">https://acarranza420-ui.github.io/DragonMax-V9-2/addons.xml</info>
        <checksum>https://acarranza420-ui.github.io/DragonMax-V9-2/addons.xml.md5</checksum>
        <datadir zip="true">https://acarranza420-ui.github.io/DragonMax-V9-2/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>DragonMax stabilization repository</summary>
      <description>DragonMax repository for Kodi 21+ with manifest-driven build installation and validation.</description>
      <platform>all</platform>
    </extension>
  </addon>

  <addon id="plugin.program.dragonmaxwizard" name="DragonMax Wizard" version="1.9.3" provider-name="DragonMax RD">
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>DragonMax transactional installer</summary>
      <description>Downloads, validates, backs up, stages, and applies DragonMax build payloads with safer failure handling.</description>
      <platform>all</platform>
    </extension>
  </addon>
</addons>
